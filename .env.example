# ============================================================
# APEX DETAILING // Atelier — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# ============================================================

# ------------------------------------------------------------
# Gmail SMTP (recommended — no custom domain needed)
# Sends enquiries from your own Gmail using an App Password.
# ------------------------------------------------------------
# Your Gmail address that sends AND receives the enquiries
SMTP_USER=johnstanleee@gmail.com

# Your Gmail APP PASSWORD (16-char, NO spaces).
# Made at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be ON for the Gmail account.
SMTP_PASS=your_16_char_app_password

# SMTP server (Gmail defaults — no change normally needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The email address that receives all booking inquiries
OWNER_EMAIL=johnstanleee@gmail.com

# ------------------------------------------------------------
# Optional: Resend (alternative) if you later verify a domain
# ------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=APEX Atelier <bookings@yourdomain.com>
</content>
